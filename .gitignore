# macOS
.DS_Store

# Python cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local environment and secrets
.env
.venv/
.venv_tiktok/
venv/
cookies.txt
# secret/

# Large model artifacts (also ignored via models/; keep for stray files)
*.pt
*.pth
*.pkl
*.ckpt

# Heavy local datasets and trained artifacts — keep repo small; use GCS in cloud.
# Ignore contents but allow a tracked README in each folder (Git cannot un-ignore files inside a fully ignored parent).
data/*
!data/README.md
models/*
!models/README.md

# Experiment outputs (heavy, regeneratable)
runs/

# Too large for GitHub (>100MB); keep locally / regenerate from pipeline
src/dataset_construction/reports/cat_id_bbox_crops.npz

# Generated video/data artifact folders (do not publish)
downloads/
downloaded_snippets/
dataset_snippets/
crawled_downloads/
crawled_snippets/

# Playwright persistent Chromium profile (TikTok cookies/session — private)
src/scrapers/tiktok/tiktok_profile/

# Archived legacy code/data — kept on disk for review, never published
_archive/

# AudioSep batch outputs (regeneratable separated audio)
audio/AudioSep/separeted_audios/separated_cat_sounds/

# Media outputs anywhere in the repository
*.mp4
*.mp3
*.webm
*.mkv
*.mov
*.avi

# Keep logs and structured metadata files in git
!logs/
!*.json
!*.jsonl
