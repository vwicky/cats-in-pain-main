# Copy to `website/.env` and adjust.

# --- Database ---------------------------------------------------------------
# Homebrew PostgreSQL: there is usually NO role named "postgres". The superuser
# is your macOS login. Omit DATABASE_URL to use:
#   postgresql+psycopg://YOUR_USERNAME@localhost:5432/catpain_web
# (computed automatically from getpass.getuser()).
#
# Docker / Linux images often use user postgres:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/catpain_web
#
# TCP fails? Try Unix socket (path may vary; `brew --prefix postgresql@16`):
# DATABASE_URL=postgresql+psycopg://YOUR_USERNAME@/catpain_web?host=/opt/homebrew/var/run

# DATABASE_URL=

# Repository root (parent of `website/`) — defaults if unset
# REPO_ROOT=/absolute/path/to/Cats-in-Pain-Bachelors

# Website data (uploads + job links)
# DATA_DIR=/absolute/path/to/Cats-in-Pain-Bachelors/website/data

FRONTEND_ORIGIN=http://localhost:5173

# Security
ALLOW_LOCAL_PATHS=0
# LOCAL_PATH_BASE_DIR=/safe/read-only/videos

MAX_UPLOAD_MB=200
MAX_VIDEO_DURATION_SEC=600
JOB_TIMEOUT_SEC=900
POSITIVE_LABEL=1
MAX_ARTIFACT_STREAM_MB=500

PIPELINE_OUTPUT_DIR=runs/inference
WRAPPER_VERSION=0.1.0
