{
  "uid": "catpain-worker-health",
  "title": "Worker Health",
  "tags": ["catpain"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Heartbeat age (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "time() - catpain_worker_last_heartbeat_timestamp",
          "legendFormat": "age"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 2,
      "title": "Worker busy",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "catpain_worker_busy", "legendFormat": "busy" }
      ]
    },
    {
      "id": 3,
      "title": "Jobs processed rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(catpain_worker_jobs_processed_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
